# Admin (Next.js) : valeurs de développement local.
# L'API AdonisJS, vers laquelle Next.js réécrit /api (même origine pour le navigateur).
# Côté API, ADMIN_URL=http://localhost:3001 (origine acceptée dans le claim `azp`).
API_INTERNAL_URL=http://127.0.0.1:3333

# Clerk : même instance que apps/web (Dashboard Clerk → API keys). Lues à l'exécution.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clé publique « PEM Public Key », sur une ligne avec des \n (même valeur que dans apps/api).
CLERK_JWT_KEY=
