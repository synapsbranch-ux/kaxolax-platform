# Compile gateway : service HTTP interne (appelé par l'API), jamais exposé publiquement.
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
# Même valeur que dans apps/api et apps/compile-agent.
INTERNAL_TOKEN=local-dev-internal-token-not-a-secret
REDIS_URL=redis://127.0.0.1:6379
# Agents de compilation : id=url, séparés par des virgules.
COMPILE_AGENTS=agent-local-1=http://127.0.0.1:3200
AGENT_HEALTH_TIMEOUT_MS=1000
AFFINITY_TTL_SECONDS=86400
