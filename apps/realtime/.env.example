# Service temps réel Kaxolax : valeurs de développement local (docker compose).
HOST=127.0.0.1
PORT=1234
LOG_LEVEL=info
# Même valeur que REALTIME_TOKEN_SECRET dans apps/api. En staging : Secrets Manager.
REALTIME_TOKEN_SECRET=local-dev-realtime-token-secret-not-a-secret
# Même valeur que INTERNAL_TOKEN dans apps/api et apps/compile-agent.
INTERNAL_TOKEN=local-dev-internal-token-not-a-secret
DATABASE_URL=postgres://kaxolax:kaxolax@127.0.0.1:5432/kaxolax
DB_SSL=false
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=10000
# Rôle relu en base à la mise à jour d'un rédacteur au-delà de ce délai, et pour toutes les
# connexions à cet intervalle (filets si une notification de l'API se perd).
ROLE_RECHECK_MS=5000
ROLE_SWEEP_MS=30000
