{
  "name": "@kaxolax/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env.example --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "catalog:",
    "@hocuspocus/server": "catalog:",
    "@kaxolax/collab": "workspace:*",
    "@kaxolax/contracts": "workspace:*",
    "pg": "catalog:",
    "pino": "catalog:",
    "ws": "catalog:",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "catalog:",
    "@kaxolax/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
