{
  "name": "@kaxolax/compile-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist --containers-rollout=none",
    "deploy": "WRANGLER_SEND_METRICS=false wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/containers": "catalog:",
    "@kaxolax/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@kaxolax/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
