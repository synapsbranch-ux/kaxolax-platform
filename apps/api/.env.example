# API Kaxolax : valeurs de développement local (docker compose). Copier en .env pour les modifier.
TZ=UTC
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Clé de chiffrement (liens de téléchargement signés). En staging : générée (node ace generate:key), jamais commitée.
APP_KEY=local-dev-app-key-not-a-secret-000000
# Origine publique de l'application (claim azp des jetons Clerk, liens des emails).
APP_URL=http://localhost:3000
# Origine de l'admin (apps/admin) : ses jetons Clerk sont acceptés (claim azp).
ADMIN_URL=http://localhost:3001
TRUSTED_PROXY_HOPS=1

# Clerk (instance de développement) : Dashboard Clerk → API keys.
# Clé publique « PEM Public Key », sur une ligne avec des \n.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kaxolax
DB_PASSWORD=kaxolax
DB_DATABASE=kaxolax

# Mailpit en local (http://localhost:8025), Amazon SES (SMTP) en staging.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@kaxolax.local
MAIL_FROM_NAME=Kaxolax

# Service temps réel (apps/realtime) : mêmes secrets que dans son .env.example.
REALTIME_TOKEN_SECRET=local-dev-realtime-token-secret-not-a-secret
INTERNAL_TOKEN=local-dev-internal-token-not-a-secret
REALTIME_PUBLIC_URL=ws://localhost:1234
REALTIME_INTERNAL_URL=http://127.0.0.1:1234

# S3 (SeaweedFS du docker-compose). Production : Cloudflare R2, S3_REGION=auto,
# S3_ENDPOINT=https://<compte>.eu.r2.cloudflarestorage.com, S3_FORCE_PATH_STYLE=true, clés d'API R2.
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=kaxolax
S3_SECRET_ACCESS_KEY=kaxolax-local-secret
S3_BUCKET_PROJECT_FILES=kaxolax-project-files
S3_BUCKET_COMPILE_OUTPUTS=kaxolax-compile-outputs
# Index des packages TeX Live publié par kaxolax-texlive-images (texlive/<année>/packages.json),
# lu avec les clés S3_* ci-dessus. Vide : fixture locale (resources/fixtures), jamais en production.
TEXLIVE_INDEX_BUCKET=
TEXLIVE_INDEX_KEY=texlive/2026/packages.json
# Compilation : gateway (synchrone, compile-gateway + agents Docker/gVisor, défaut local et CI)
# ou cloudflare (asynchrone, Worker + Containers, production).
COMPILE_BACKEND=gateway
# Compile gateway (apps/compile-gateway), qui répartit les compilations entre les agents.
COMPILE_GATEWAY_URL=http://127.0.0.1:3100
# Mode cloudflare : URL du Worker (https://compile.<domaine>) et secret partagé avec lui
# (au moins 32 caractères, `wrangler secret put COMPILE_WORKER_SECRET`).
COMPILE_WORKER_URL=
COMPILE_WORKER_SECRET=
# Historique : balayage des versions automatiques (2 min sans modification) et purge des versions
# expirées selon le plan du propriétaire, en secondes, dans chaque processus web (0 : désactivé).
HISTORY_SWEEP_SECONDS=30
# Délai avant un nouvel essai de version automatique après un échec (le projet sort du balayage).
HISTORY_RETRY_SECONDS=600
HISTORY_PURGE_SECONDS=3600
# Galerie : catalogue templates.json publié par kaxolax-templates (bucket R2 public). Vide hors
# production : catalogue de démonstration (resources/templates.fixture.json, sans fichiers).
# En local, avec les sorties de `scripts/build.sh` du dépôt kaxolax-templates :
# python3 -m http.server 8787 -d dist, puis TEMPLATES_CATALOG_URL=http://localhost:8787/templates.json
TEMPLATES_CATALOG_URL=
# Base des fichiers (PDF, miniatures, zip) ; défaut : dossier du catalogue.
TEMPLATES_PUBLIC_URL=
# IA (Claude, API Anthropic) : clé de l'API, côté API seulement (Console Anthropic → API keys).
# Vide : l'assistant IA est désactivé (routes de l'IA : 503 E_AI_UNAVAILABLE), le reste fonctionne.
ANTHROPIC_API_KEY=
