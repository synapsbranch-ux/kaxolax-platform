# API Kaxolax : valeurs de développement local (docker compose). Copier en .env pour les modifier.
TZ=UTC
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Clé de chiffrement (cookies, sessions). En staging : générée (node ace generate:key), jamais commitée.
APP_KEY=local-dev-app-key-not-a-secret-000000
# Origine publique de l'application (liens des emails).
APP_URL=http://localhost:3000
TRUSTED_PROXY_HOPS=1

SESSION_DRIVER=redis
LIMITER_STORE=redis

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=kaxolax
DB_PASSWORD=kaxolax
DB_DATABASE=kaxolax

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Mailpit en local (http://localhost:8025), Amazon SES (SMTP) en staging.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM_ADDRESS=no-reply@kaxolax.local
MAIL_FROM_NAME=Kaxolax
