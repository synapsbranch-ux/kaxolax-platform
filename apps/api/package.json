{
  "name": "@kaxolax/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ace build",
    "dev": "node -e \"const f=require('node:fs');f.existsSync('.env')||f.copyFileSync('.env.example','.env')\" && node ace serve --hmr",
    "start": "node build/bin/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node -e \"const f=require('node:fs');f.existsSync('.env')||f.copyFileSync('.env.example','.env')\" && node ace test",
    "migrate": "node -e \"const f=require('node:fs');f.existsSync('.env')||f.copyFileSync('.env.example','.env')\" && node ace migration:run"
  },
  "imports": {
    "#auth/*": "./app/auth/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#policies/*": "./app/policies/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "catalog:",
    "@adonisjs/core": "catalog:",
    "@adonisjs/lucid": "catalog:",
    "@adonisjs/mail": "catalog:",
    "@adonisjs/shield": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@clerk/backend": "catalog:",
    "@kaxolax/collab": "workspace:*",
    "@kaxolax/contracts": "workspace:*",
    "@kaxolax/upload-processor": "workspace:*",
    "@kaxolax/zip-importer": "workspace:*",
    "@vinejs/vine": "catalog:",
    "luxon": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "yazl": "catalog:"
  },
  "devDependencies": {
    "@adonisjs/assembler": "catalog:",
    "@adonisjs/tsconfig": "catalog:",
    "@japa/api-client": "catalog:",
    "@japa/assert": "catalog:",
    "@japa/plugin-adonisjs": "catalog:",
    "@japa/runner": "catalog:",
    "@kaxolax/config": "workspace:*",
    "@poppinss/ts-exec": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/yazl": "catalog:",
    "eslint": "catalog:",
    "hot-hook": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
