# Agent de compilation : service HTTP interne, jamais exposé publiquement. Mode `gateway` (local et
# CI) ; en production, la compilation passe par le Worker Cloudflare (apps/compile-worker), qui
# lance le même agent dans son conteneur (point d'entrée container-main), sans ces variables.
# Valeurs de développement local. Copier en .env pour les modifier (le .env l'emporte).
HOST=127.0.0.1
PORT=3200
AGENT_ID=agent-local-1
# Secret partagé entre services internes (32 caractères minimum), même valeur que l'API.
INTERNAL_TOKEN=local-dev-internal-token-not-a-secret
LOG_LEVEL=info

COMPILE_IMAGE=kaxolax-texlive:2026-medium
# runc en local, runsc (gVisor) sur un hôte qui l'installe (sandbox de l'étape 1).
COMPILE_RUNTIME=runc
DOCKER_SOCKET=/var/run/docker.sock
MAX_CONCURRENT_COMPILES=2

COMPILES_DIR=.data/compiles
CACHE_DIR=.data/cache

# SeaweedFS du docker-compose.
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=kaxolax
S3_SECRET_ACCESS_KEY=kaxolax-local-secret
S3_BUCKET_PROJECT_FILES=kaxolax-project-files
S3_BUCKET_COMPILE_OUTPUTS=kaxolax-compile-outputs
