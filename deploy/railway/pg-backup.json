{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scripts/backup/Dockerfile",
    "watchPatterns": ["scripts/backup/**"]
  },
  "deploy": {
    "startCommand": "/opt/kaxolax/backup/pg-backup.sh",
    "cronSchedule": "17 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
