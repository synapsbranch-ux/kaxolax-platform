# Fins de ligne LF partout, même si un fichier est modifié côté Windows.
* text=auto eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.gz binary
# Logs réels de TeX Live : octets exacts, sans normalisation des fins de ligne (LuaLaTeX recopie
# par exemple le CR d'une ligne de contexte).
packages/latex-log-parser/test/fixtures/** -text
